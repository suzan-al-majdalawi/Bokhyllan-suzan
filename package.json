{
  "name": "react-fran-grunden",
  "private": true,
  "version": "1.0.0",
  "description": "Minikurs: bygg appen Bokhyllan i React i fem steg",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "postinstall": "npm install --prefix api && npm install --prefix app && npm install --prefix vue-reference",
    "api": "node api/server.js",
    "dev": "npm run dev --prefix app",
    "dev:vue": "npm run dev --prefix vue-reference",
    "test": "npm test --prefix app",
    "test:e2e": "playwright test",
    "check:1": "playwright test e2e/steg-1.spec.js",
    "check:2": "playwright test e2e/steg-2.spec.js",
    "check:3": "playwright test e2e/steg-3.spec.js",
    "check:4": "playwright test e2e/steg-4.spec.js",
    "check:5": "node scripts/check-5.mjs",
    "check:1-2": "playwright test e2e/steg-1.spec.js e2e/steg-2.spec.js",
    "check:1-3": "playwright test e2e/steg-1.spec.js e2e/steg-2.spec.js e2e/steg-3.spec.js",
    "check:1-4": "playwright test e2e/steg-1.spec.js e2e/steg-2.spec.js e2e/steg-3.spec.js e2e/steg-4.spec.js"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0"
  }
}
